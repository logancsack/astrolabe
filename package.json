{
  "name": "astrolabe",
  "version": "0.3.0-beta.0",
  "description": "Astrolabe beta: OpenClaw-first Responses router for OpenRouter with static manifests, safety policy, and cost-aware routing.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:http": "node --test tests/http.test.js tests/streaming.test.js",
    "test:routing": "node --test tests/routing.test.js",
    "check": "npm test && npm run validate:models",
    "benchmark": "node scripts/benchmark-runtime.js",
    "smoke:production": "node scripts/smoke-production.js",
    "validate:models": "node scripts/validate-model-manifest.js",
    "docs:dev": "cd docs && npx mint dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "express": "^5.1.0"
  }
}
